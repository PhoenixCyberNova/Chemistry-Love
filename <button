const grid = document.getElementById('reactionGrid');
const countEl = document.getElementById('reactionCount');
let currentFilter = "all";
let searchQuery = "";

function renderReactions() {
  const filtered = reactions.filter(r => {
    const matchChapter = currentFilter === "all" || r.ch === currentFilter;
    const text = (r.title + r.eq + r.type + r.colour + r.obs + r.cond + r.tip + r.desc).toLowerCase();
    const matchSearch = text.includes(searchQuery.toLowerCase());
    return matchChapter && matchSearch;
  });

  countEl.textContent = `Showing ${filtered.length} of ${reactions.length} reactions`;

  if (filtered.length === 0) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:#6b7280;">No reactions found. Try a different keyword.</div>`;
    return;
  }

  grid.innerHTML = filtered.map(r => `
    <article class="reaction-card">
      <div class="reaction-top">
        <h3>${r.title}</h3>
        <span class="reaction-tag">${r.type}</span>
      </div>
      <div class="equation-box">${r.eq}</div>
      <div class="meta-grid">
        <div class="meta-item"><b>Colour</b><span>${r.colour}</span></div>
        <div class="meta-item"><b>Observation</b><span>${r.obs}</span></div>
        <div class="meta-item"><b>Condition</b><span>${r.cond}</span></div>
        <div class="meta-item"><b>Exam Tip</b><span>${r.tip}</span></div>
      </div>
      <div class="reaction-desc">${r.desc}</div>
    </article>
  `).join('');
}

